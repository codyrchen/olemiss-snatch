# Copy to .env and fill in. .env is ignored by git; never commit it.
# On Railway, set these as service Variables instead of using a file.

# Email, option 1 (hosting): Resend API key. Used instead of SMTP when set.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=RebelSnatch <alerts@yourdomain.com>

# Email, option 2 (local Mac): Gmail SMTP.
# SMTP_PASSWORD is a 16-character App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=abcdabcdabcdabcd
MAIL_FROM=OleMiss Snatch <you@gmail.com>

# Website
# SECRET_KEY signs logins and unsubscribe links. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Public address of the site (used in emailed links)
BASE_URL=http://127.0.0.1:5000
# Who may sign in (comma-separated)
ALLOWED_EMAIL_DOMAINS=go.olemiss.edu,olemiss.edu

# Poller (used by start.sh on the server; flags override these locally)
# Space-separated term codes to watch, e.g. Spring and Fall
SNATCH_TERMS=202730 202710
# Where the database lives (Railway: on the volume)
SNATCH_DB=snatch.db
# Seconds between polling passes
POLL_EVERY=300

# Text alerts (optional): Twilio account SID, auth token, and the number texts come from
# TWILIO_SID=ACxxxxxxxx
# TWILIO_TOKEN=xxxxxxxx
# TWILIO_FROM=+18005550123

# Only check seats during these windows (Central time). Leave unset to check all the time.
# POLL_WINDOWS=2026-11-02 07:00 to 2026-11-20 23:59; 2027-01-12 06:00 to 2027-01-26 23:59

# Max sections one student can watch per term (default 15)
# MAX_SUBSCRIPTIONS=15

# Who can open /admin (comma-separated)
# ADMIN_EMAILS=you@go.olemiss.edu
